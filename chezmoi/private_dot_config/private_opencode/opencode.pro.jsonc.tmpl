{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "agents": {
    "build": {
      "model": "openai/gpt-6-astra#medium",
      "steps": 50
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#high",
      "steps": 30
    },
    "general": {
      "model": "openai/gpt-6.1-terra#medium"
    },
    "explore": {
      "model": "openai/gpt-6-luna#low",
      "steps": 20
    },
    "compaction": {
      "model": "openai/gpt-6-luna#low"
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    },
    "summary": {
      "model": "openai/gpt-6-luna#low"
    },
    "draft": {
      "description": "Quick prototyping and boilerplate with a low-cost model. Use for initial scaffolding, simple utilities, or first drafts before final implementation.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" }
      ],
      "steps": 20
    },
    "review": {
      "description": "Reviews code with read-only access. Use for security audits, performance analysis, or an independent quality check.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#high",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ],
      "steps": 30
    }
  }
}
