{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-5.6-terra",
  "small_model": "opencode/gpt-5.6-luna",
  "agent": {
    "build": {
      "model": "opencode/gpt-5.6-terra",
      "variant": "medium",
      "steps": 50
    },
    "plan": {
      "model": "opencode/gpt-5.6-sol",
      "variant": "high",
      "steps": 15
    },
    "general": {
      "model": "opencode/gpt-5.6-sol",
      "variant": "medium"
    },
    "explore": {
      "model": "opencode/gpt-5.6-luna",
      "variant": "low",
      "steps": 20
    },
    "compaction": {
      "model": "opencode/gpt-5.6-luna",
      "variant": "low"
    },
    "title": {
      "model": "opencode/gpt-5.6-luna",
      "variant": "none"
    },
    "draft": {
      "description": "Quick prototyping and boilerplate with a low-cost model. Use for initial scaffolding, simple utilities, or first drafts before final implementation.",
      "mode": "subagent",
      "model": "opencode/gpt-5.6-luna",
      "variant": "low",
      "permission": {
        "bash": "deny"
      },
      "steps": 10
    },
    "review": {
      "description": "Reviews code with read-only access. Use for security audits, performance analysis, or an independent quality check.",
      "mode": "subagent",
      "model": "opencode/gpt-5.6-terra",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "steps": 10
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "glm-5": {
          "variants": {
            "fast": {
              "temperature": 0.3
            },
            "precise": {
              "temperature": 0.1
            }
          }
        }
      }
    }
  }
}
