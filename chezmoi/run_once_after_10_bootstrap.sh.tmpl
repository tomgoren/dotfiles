#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed; skipping brew bundle bootstrap."
  exit 0
fi

if [[ -f "${HOME}/.Brewfile" ]]; then
  brew bundle --global
fi

if command -v nvim >/dev/null 2>&1; then
  nvim --headless '+MasonToolsInstallSync' '+qa'
fi
